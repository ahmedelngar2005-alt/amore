rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Product images: public read, authenticated admin write only
    // Enforces: max 5MB, image files only
    match /products/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

// Only these signed-in emails can upload/delete product images. Put YOUR admin email here.
function isAdmin() {
  return request.auth != null
    && request.auth.token.email in ['admin@amore.com'];
}
